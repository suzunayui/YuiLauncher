{
  "name": "yui-launcher",
  "version": "2026.1108.1",
  "private": true,
  "description": "Launch and update Yui apps",
  "author": "YUI",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/prepare-tauri-frontend.cjs && cargo run --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node tests/ui.cjs",
    "icon": "node scripts/make-icon.cjs",
    "dist": "tauri build && node scripts/package-release.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "png-to-ico": "^3.0.2"
  }
}
